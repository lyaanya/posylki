# Скопируйте этот файл в .env и заполните реальными значениями.
# Реальный .env никогда не попадает в git (см. .gitignore).

# local | staging | production
NODE_ENV=local

# Порт, на котором слушает бэкенд (apps/api)
PORT=3000

# --- Supabase (apps/api) ---
# Адрес проекта Supabase. Определяет и регион размещения данных (E01.7):
# смена региона — это замена значения здесь, без правки кода.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service role key — полный доступ в обход RLS, используется только на бэкенде.
# Никогда не передаётся клиентам и не попадает в логи.
SUPABASE_SERVICE_KEY=

# Anon key — публичный ключ, безопасен для клиентов.
SUPABASE_ANON_KEY=

# Прямое подключение к Postgres для слоя репозиториев (нужно для
# настоящих транзакций — PostgREST/anon/service-ключи их не дают).
# Взять в Project Settings → Database → Connection string → Transaction pooler,
# вписав пароль от базы (Project Settings → Database → Database password).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- ИИ-сервис (E13) ---
# Необязателен: без ключа AiService ведёт себя как при сбое сценария
# (E13 п. 13.6), приложение всё равно запускается и работает.
# Бесплатный ключ — на console.groq.com → API Keys.
GROQ_API_KEY=

# gpt-oss-120b (открытая модель OpenAI, бесплатно через Groq) по умолчанию,
# менять только через переменную.
GROQ_MODEL=openai/gpt-oss-120b
